{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "allow": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule",
          "quote",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "allow"
  ],
  "additionalProperties": false
}

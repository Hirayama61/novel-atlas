{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scale": {
      "type": "string"
    },
    "policy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "確定",
              "仮"
            ]
          },
          "theme": {
            "type": "string"
          },
          "closing_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "arcs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "episodes": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "episodes",
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "episodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ep": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sketch": {
                  "type": "string"
                },
                "hook": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "ep",
                "sketch"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "no",
          "title",
          "status",
          "theme"
        ],
        "additionalProperties": false
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "chapters"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "episode": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pr": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "comment_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "path": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "quote": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(vocab|punctuation|structure|canon|praise|taste|layout|voice:[A-Za-z0-9._-]+)$"
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "採用",
              "却下",
              "保留",
              "依頼者決定"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "change": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          },
          "rule_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "vocab_pattern": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "round",
          "body",
          "tags",
          "decision"
        ],
        "additionalProperties": false
      }
    },
    "reviews": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "round": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "reviewer",
          "round",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "retro": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "decision",
          "why"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "episode",
    "pr",
    "rounds",
    "items"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text_sha": {
      "type": "string"
    },
    "extractor": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model",
        "prompt_version"
      ],
      "additionalProperties": false
    },
    "speakers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "who": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "line",
          "who"
        ],
        "additionalProperties": false
      }
    },
    "names": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "resolves_to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "quote",
          "resolves_to"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "about": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "about",
          "value",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "time_markers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "relative_to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "gap_days": {
            "type": [
              "number",
              "null"
            ]
          },
          "calendar": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "day": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "knowledge_use": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "fact": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "who",
          "fact",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "ability_use": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "fired": {
            "type": "boolean"
          },
          "drift": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "who",
          "quote",
          "kind",
          "fired"
        ],
        "additionalProperties": false
      }
    },
    "threads": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "plant",
              "advance",
              "payoff",
              "echo"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "design_realization": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "text_sha",
    "extractor"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "確定",
              "仮"
            ]
          },
          "since": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ep": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ep",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "note": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "planted": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ep": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ep": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "ep",
                        "quote"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "ep"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "answer": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "確定",
                  "仮"
                ]
              }
            },
            "required": [
              "text",
              "status"
            ],
            "additionalProperties": false
          },
          "reveal": {
            "type": "object",
            "properties": {
              "not_before": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "planned": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "sealed_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ep": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "plant",
                    "advance",
                    "payoff",
                    "echo"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ep": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ep",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "ep",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "due": {
                  "type": "object",
                  "properties": {
                    "by_episode": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "by_chapter": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "title",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "threads"
  ],
  "additionalProperties": false
}
